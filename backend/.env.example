# Copy this file to .env and adjust as needed.

# SQLite database file used by the application
DATABASE_URL=sqlite:///./instance/pvc_arvand.db

# Path to the original Access database, only needed when running the migration script
ACCESS_DB_PATH=C:\Users\Omid\Downloads\New folder (4)\PVC_Arvand_kofigurierte Datenbank.mdb

# CORS - the Next.js dev server origin
FRONTEND_ORIGIN=http://localhost:3000

# Auth - CHANGE THESE before any production deployment (see SECURITY.md).
JWT_SECRET_KEY=pvc-arvand-dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Host / port used when the backend serves the UI itself (installer + Docker).
# Desktop default is 127.0.0.1:8080. Docker sets APP_HOST=0.0.0.0.
APP_HOST=127.0.0.1
APP_PORT=8080
