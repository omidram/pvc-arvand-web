# Copy to `.env` in the project root before the first start if you want
# a different public port or admin password. `.env` is not committed.

APP_PUBLISH_PORT=8080
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Host folder for ARIAORMS LogSheets Excel exports (synced into Standardized Voltage).
# Export from http://192.168.20.12:8080/LogSheetsReports.aspx → Excel, save into this folder.
ARIAORMS_EXPORT_DIR=./ariaorms_exports
